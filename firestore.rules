rules_version = '2';

// CEI-35: who can read and write the customer data in Firestore.
// Anything not allowed below is blocked by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per customer. The document ID is the customer's Firebase Auth uid,
    // so customers/abc123 belongs to the person who signed in as abc123.
    // Passwords are never stored here; Firebase Auth handles those.
    match /customers/{customerId} {
      allow read: if isOwner(customerId);

      allow create: if isOwner(customerId)
        && validCustomer(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // createdAt can't be changed after the account is made
      allow update: if isOwner(customerId)
        && validCustomer(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // customers can't delete their own profile from the app
      allow delete: if false;
    }

    function isOwner(customerId) {
      return request.auth != null && request.auth.uid == customerId;
    }

    // Same rules as the Create Account screen (src/helpers/AccountHelp.ts),
    // so bad data is rejected even if someone skips the app.
    function validCustomer(data) {
      let fields = ['fullName', 'email', 'phone', 'address', 'city', 'state', 'zip', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.fullName is string && data.fullName.trim().size() > 0 && data.fullName.size() <= 100
        && data.email is string && data.email.matches('[^\\s@]+@[^\\s@]+\\.[^\\s@]+') && data.email.size() <= 254
        && data.phone is string && data.phone.matches('\\+?[0-9 ().-]+')
        && data.phone.replace('[^0-9]', '').size() >= 10 && data.phone.replace('[^0-9]', '').size() <= 15
        && data.address is string && data.address.trim().size() > 0 && data.address.size() <= 200
        && data.city is string && data.city.trim().size() > 0 && data.city.size() <= 100
        && data.state is string && data.state.matches('[A-Z]{2}')
        && data.zip is string && data.zip.matches('[0-9]{5}(-[0-9]{4})?')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
  }
}
